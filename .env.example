# ==========================================
# RustTrack - Environment Configuration
# ==========================================

# Server Settings
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rusttrack
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5

# Session & Security Settings
# Generate a secure 64-character random string for production
SESSION_SECRET=dev_session_secret_must_be_changed_in_production_32_bytes_min
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=localhost

# Storage Settings
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads
MAX_FILE_SIZE_MB=25

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
